---
import { company, nav } from "../data/company";
import { withBase } from "../lib/url";
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isActive = (href: string) => {
  const target = `${base}${href}`;
  return href === "/" ? path === `${base}/` || path === base : path.startsWith(target);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase("/")} class="brand" aria-label={`${company.name} トップ`}>
      <span class="brand__mark" aria-hidden="true">EC</span>
      <span class="brand__text">
        <strong>EastCore</strong>
        <small>株式会社イーストコア</small>
      </span>
    </a>

    <input type="checkbox" id="navToggle" class="nav-toggle" hidden />
    <label for="navToggle" class="nav-burger" aria-label="メニューを開閉">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="グローバルナビゲーション">
      <ul>
        {
          nav
            .filter((n) => !["/download/", "/contact/"].includes(n.href))
            .map((n) => (
              <li>
                <a href={withBase(n.href)} class={isActive(n.href) ? "is-active" : ""}>
                  {n.label}
                </a>
              </li>
            ))
        }
      </ul>
      <div class="site-nav__cta">
        <a href={withBase("/download/")} class="btn btn--ghost">資料ダウンロード</a>
        <a href={withBase("/contact/")} class="btn btn--primary">お問い合わせ</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--navy);
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--turquoise), var(--turquoise-deep));
    color: #fff;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand__text strong {
    font-size: 1.15rem;
    color: var(--navy);
  }
  .brand__text small {
    font-size: 0.7rem;
    color: var(--ink-soft);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .site-nav ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    padding-block: 6px;
    position: relative;
  }
  .site-nav ul a.is-active,
  .site-nav ul a:hover {
    color: var(--turquoise-deep);
  }
  .site-nav ul a.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--turquoise);
  }
  .site-nav__cta {
    display: flex;
    gap: 10px;
  }
  .site-nav__cta .btn {
    padding: 9px 18px;
    font-size: 0.85rem;
  }

  /* ハンバーガー */
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
  }
  .nav-burger span {
    width: 26px;
    height: 2px;
    background: var(--navy);
    transition: 0.25s;
  }

  @media (max-width: 940px) {
    .nav-burger {
      display: flex;
    }
    .site-nav {
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      padding: 12px 24px 24px;
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: 0.2s;
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav ul li {
      border-bottom: 1px solid var(--line);
    }
    .site-nav ul a {
      display: block;
      padding: 14px 0;
    }
    .site-nav__cta {
      flex-direction: column;
      margin-top: 16px;
    }
    .site-nav__cta .btn {
      padding: 13px 18px;
      font-size: 0.95rem;
    }
    .nav-toggle:checked ~ .site-nav {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
