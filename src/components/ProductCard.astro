---
import type { Product } from "../data/products";
import { withBase } from "../lib/url";
interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<a href={withBase(`/products/${product.slug}/`)} class="product-card card">
  <div class="product-card__thumb">
    {
      product.image ? (
        <img
          src={withBase(product.image)}
          alt={product.imageAlt ?? product.name}
          loading="lazy"
          width="400"
          height="260"
        />
      ) : (
        <span class="product-card__placeholder">{product.model}</span>
      )
    }
  </div>
  <span class="badge">{product.category}</span>
  <h3>{product.name}</h3>
  <p>{product.short}</p>
  <span class="product-card__more">詳細を見る →</span>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--ink);
    padding: 0;
    overflow: hidden;
  }
  .product-card__thumb {
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #f4f8f9, #ecf8f6);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .product-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
  }
  .product-card__placeholder {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--turquoise-deep);
    opacity: 0.5;
  }
  .product-card .badge {
    align-self: flex-start;
    margin: 24px 24px 14px;
  }
  .product-card h3,
  .product-card p,
  .product-card__more {
    padding-inline: 24px;
  }
  .product-card__more {
    padding-bottom: 24px;
  }
  .product-card h3 {
    font-size: 1.15rem;
    margin-bottom: 10px;
  }
  .product-card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    flex-grow: 1;
  }
  .product-card__more {
    color: var(--turquoise-deep);
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 12px;
  }
</style>
