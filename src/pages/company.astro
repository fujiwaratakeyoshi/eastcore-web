---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import CtaBand from "../components/CtaBand.astro";
import { company, emailAddress } from "../data/company";

const description = `${company.name}の会社概要。所在地（${company.address}）、設立、資本金、事業内容、連絡先をご案内します。`;

const rows = [
  { label: "社名", value: company.name },
  { label: "所在地", value: `${company.zip} ${company.address}` },
  { label: "設立", value: company.established },
  { label: "資本金", value: company.capital },
  { label: "事業内容", value: company.business },
  { label: "電話番号", value: company.tel },
  { label: "FAX", value: company.fax },
  { label: "メール", value: emailAddress },
  { label: "営業時間", value: company.businessHours },
];
---

<BaseLayout title="会社概要" description={description}>
  <Breadcrumb items={[{ label: "会社概要" }]} />
  <section class="section">
    <div class="container narrow">
      <div class="section-head" style="text-align:left;margin-bottom:32px">
        <span class="eyebrow">Company</span>
        <h2>会社概要</h2>
      </div>

      <p class="lead">{company.description}</p>

      <table class="spec-table">
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th>{r.label}</th>
                <td>
                  {r.label === "メール" ? (
                    <a href={`mailto:${emailAddress}`}>{r.value}</a>
                  ) : r.label === "電話番号" ? (
                    <a href={`tel:${company.tel.replace(/-/g, "")}`}>{r.value}</a>
                  ) : (
                    r.value
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h3 class="mt">アクセス</h3>
      <p>
        {company.zip} {company.address}<br />
        最寄り駅からのアクセス等の詳細はお問い合わせください。
      </p>
      <div class="map">
        <iframe
          title="所在地の地図"
          width="100%"
          height="360"
          style="border:0;border-radius:12px"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://maps.google.com/maps?q=${encodeURIComponent(company.address)}&output=embed`}
        ></iframe>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  .lead {
    color: var(--ink-soft);
    margin-bottom: 28px;
  }
  .mt {
    margin-top: 40px;
    font-size: 1.2rem;
  }
  .map {
    margin-top: 16px;
  }
</style>
