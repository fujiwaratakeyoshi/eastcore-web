<?php
// お問い合わせ・資料請求フォーム受信スクリプト（株式会社イーストコア）
// エックスサーバー等のPHP環境で動作。お問い合わせ(contact)・資料請求(download)兼用。
// 送信先は自ドメイン固定。ユーザー入力の宛先は一切使わない（オープンリレー防止）。

declare(strict_types=1);

mb_language("Japanese");
mb_internal_encoding("UTF-8");

// 宛先・送信元・サイトURL
$mailTo   = "info@example.com"; // 実際の受信アドレスに変更する
$mailFrom = "info@example.com"; // 送信元は到達性のため必ず自ドメイン（変更しない）
$siteUrl  = "https://eastcore.jp";

// POST以外はお問い合わせページへ戻す
if (($_SERVER["REQUEST_METHOD"] ?? "") !== "POST") {
    header("Location: {$siteUrl}/contact/");
    exit;
}

// スパム対策（ハニーポット）: bot が埋めるので、値があれば成功を装って破棄
if (trim((string)($_POST["_gotcha"] ?? "")) !== "") {
    header("Location: {$siteUrl}/thanks/", true, 303);
    exit;
}

// POST値の取得
function v(string $key): string
{
    return trim((string)($_POST[$key] ?? ""));
}

// メールヘッダインジェクション対策: 改行を空白へ
function clean(string $s): string
{
    return str_replace(["\r", "\n"], " ", $s);
}

$company = v("company");
$name    = v("name");
$email   = v("email");
$consent = v("consent");

// 必須項目の検証
$errors = [];
if ($company === "") {
    $errors[] = "会社名・機関名";
}
if ($name === "") {
    $errors[] = "お名前";
}
if ($email === "" || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
    $errors[] = "メールアドレス（正しい形式）";
}
if ($consent === "") {
    $errors[] = "プライバシーポリシーへの同意";
}

// エラー時は簡易ページを表示して前ページへ戻れるようにする
if ($errors !== []) {
    http_response_code(400);
    $list = htmlspecialchars(implode("、", $errors), ENT_QUOTES, "UTF-8");
    echo "<!doctype html><html lang='ja'><head><meta charset='utf-8'>";
    echo "<meta name='viewport' content='width=device-width,initial-scale=1'>";
    echo "<meta name='robots' content='noindex'><title>送信エラー</title></head><body>";
    echo "<div style='font-family:sans-serif;max-width:560px;margin:80px auto;padding:0 20px;line-height:1.9;color:#243b4a'>";
    echo "<h1 style='font-size:1.3rem'>送信できませんでした</h1>";
    echo "<p>次の項目をご確認のうえ、もう一度お試しください。</p>";
    echo "<p style='color:#9a3412;font-weight:700'>{$list}</p>";
    echo "<p><a href='javascript:history.back()' style='color:#0e7d74'>← 前のページに戻る</a></p>";
    echo "</div></body></html>";
    exit;
}

// 件名（フォームの _subject があれば利用。なければお問い合わせ）
$subjectRaw = v("_subject");
$subject = "【eastcore.jp】" . ($subjectRaw !== "" ? $subjectRaw : "お問い合わせ");

// 本文（送られてきた既知項目をラベル付きで整形）
$labels = [
    "company"    => "会社名・機関名",
    "department" => "部署名",
    "name"       => "お名前",
    "email"      => "メールアドレス",
    "tel"        => "電話番号",
    "product"    => "ご関心のある製品",
    "material"   => "ご希望の資料",
    "message"    => "お問い合わせ内容",
];

$lines = [];
foreach ($labels as $key => $label) {
    $val = v($key);
    if ($val !== "") {
        $lines[] = "■ {$label}\n{$val}";
    }
}

$body  = "eastcore.jp のフォームから送信がありました。\n";
$body .= "----------------------------------------\n\n";
$body .= implode("\n\n", $lines) . "\n\n";
$body .= "----------------------------------------\n";
$body .= "送信日時: " . date("Y-m-d H:i:s") . "\n";
$body .= "IPアドレス: " . ($_SERVER["REMOTE_ADDR"] ?? "-") . "\n";

// メールヘッダ（From は自ドメイン、返信先は入力者）
$fromName = mb_encode_mimeheader("株式会社イーストコア Webフォーム");
$headers  = "From: {$fromName} <{$mailFrom}>\r\n";
$headers .= "Reply-To: " . clean($email) . "\r\n";

// 送信（第5引数の -f で エンベロープFrom を自ドメインに固定＝到達性向上）
$ok = mb_send_mail($mailTo, $subject, $body, $headers, "-f{$mailFrom}");

if ($ok) {
    header("Location: {$siteUrl}/thanks/", true, 303);
    exit;
}

// 送信失敗
http_response_code(500);
echo "<!doctype html><html lang='ja'><head><meta charset='utf-8'>";
echo "<meta name='viewport' content='width=device-width,initial-scale=1'>";
echo "<meta name='robots' content='noindex'><title>送信エラー</title></head><body>";
echo "<div style='font-family:sans-serif;max-width:560px;margin:80px auto;padding:0 20px;line-height:1.9;color:#243b4a'>";
echo "<h1 style='font-size:1.3rem'>送信に失敗しました</h1>";
echo "<p>お手数ですが、時間をおいて再度お試しいただくか、";
echo "<a href='mailto:{$mailTo}' style='color:#0e7d74'>{$mailTo}</a> まで直接ご連絡ください。</p>";
echo "</div></body></html>";
exit;
