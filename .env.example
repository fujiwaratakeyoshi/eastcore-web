# フォーム送信先（本番は https://eastcore.jp/send.php）
# 例: https://formspree.io/f/xxxxxxxx
PUBLIC_FORM_ENDPOINT=

# 公開前の検証環境では 1 にするとサイト全体を noindex にできる（本番公開時は空 or 0）
PUBLIC_NOINDEX=1

# サイトに表示する連絡先メールアドレス（実アドレスはリポジトリに載せない）
# 例: PUBLIC_EMAIL_USER=info / PUBLIC_EMAIL_DOMAIN=example.com → info@example.com
PUBLIC_EMAIL_USER=
PUBLIC_EMAIL_DOMAIN=
